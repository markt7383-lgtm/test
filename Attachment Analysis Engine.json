    {
      "parameters": {
        "jsCode": "function extractText(raw) {\n  if (raw == null) return '';\n  if (typeof raw === 'string') return raw;\n  if (Array.isArray(raw)) return raw.map(extractText).filter(Boolean).join(' ').trim();\n  if (typeof raw === 'object') {\n    if (typeof raw.text === 'string') return raw.text;\n    if (raw.type === 'output_text' && typeof raw.text === 'string') return raw.text;\n    if (raw.content) return extractText(raw.content);\n    if (raw.output) return extractText(raw.output);\n    if (raw.message) return extractText(raw.message);\n  }\n  return '';\n}\nconst j = $input.first().json;\nconst desc = extractText(j.output ?? j.content ?? j.text ?? j) || 'No description';\nreturn [{ json: {\n  content_nature: 'Image / Visual content',\n  summary: desc,\n  file_type: $('Detect File Type').first().json.fileExtension || 'image',\n  sender: $('Gmail Trigger').first().json.from || 'Unknown Sender'\n} }];"
      },
